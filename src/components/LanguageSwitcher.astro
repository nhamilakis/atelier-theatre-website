---
import { LOCALES, LOCALE_NAMES } from "../i18n/config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { currentSubpath } from "../lib/i18n-path";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Keep the reader on the same page when they switch language.
const subpath = currentSubpath(Astro.url.pathname, import.meta.env.BASE_URL);
---

<nav class="lang-switcher" aria-label="Langue / Γλώσσα">
  <ul role="list">
    {
      LOCALES.map((loc) => (
        <li>
          <a
            href={getRelativeLocaleUrl(loc, subpath)}
            hreflang={loc}
            lang={loc}
            aria-current={loc === lang ? "page" : undefined}
            class:list={["lang-switcher__link", { "is-active": loc === lang }]}
          >
            {LOCALE_NAMES[loc]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .lang-switcher ul {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lang-switcher__link {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    font-size: var(--chrome-text-size);
    text-decoration: none;
    color: color-mix(in srgb, var(--chrome-text) 70%, transparent);
    border-radius: var(--radius);
  }

  .lang-switcher__link:hover {
    color: var(--chrome-text);
    background-color: rgba(255, 255, 255, 0.12);
  }

  .lang-switcher__link.is-active {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
