---
// Temporary page body for sections not built yet (team until step 3, plus
// community and contact, which are a later batch). Shows the section title and
// a short localized "under construction" note.
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
  title: string;
}

const { lang, title } = Astro.props;

const note: Record<Locale, string> = {
  el: "Αυτή η σελίδα ετοιμάζεται.",
  fr: "Cette page est en préparation.",
};
---

<section class="section">
  <div class="container">
    <h1 class="section__title">{title}</h1>
    <p class="prose">{note[lang]}</p>
  </div>
</section>
