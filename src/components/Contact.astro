---
// Contact page: a short note, email, address and social links on one side, and
// a map of where the workshop takes place on the other. The map embed is taken
// from `mapEmbedSrc` if set, otherwise derived from the `address`.
import Markdown from "./Markdown.astro";
import SocialLink from "./SocialLink.astro";
import type { SiteContent } from "../data/types";

interface Props {
  contact: SiteContent["contact"];
}

const { contact } = Astro.props;

const mapSrc =
  contact.mapEmbedSrc ??
  (contact.address
    ? `https://www.google.com/maps?q=${encodeURIComponent(contact.address)}&output=embed`
    : null);

// tel: href keeps only + and digits so the number is still dialable.
const telHref = contact.tel_communaute?.replace(/[^+\d]/g, "");
---

<article class="contact section">
  <div class="container">
    <h1 class="section__title">{contact.title}</h1>

    <div class="contact__grid">
      <div class="contact__details">
        <div class="prose">
          <Markdown text={contact.body} />
        </div>

        {
          contact.courses && (
            <div class="contact__courses">
              <Markdown text={contact.courses} />
            </div>
          )
        }

        {
          contact.email && (
            <p class="contact__email">
              <svg class="contact__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
              </svg>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </p>
          )
        }

        {
          contact.tel_communaute && (
            <p class="contact__tel">
              <svg class="contact__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" />
              </svg>
              <a href={`tel:${telHref}`}>{contact.tel_communaute}</a>
            </p>
          )
        }

        {contact.address && <p class="contact__address">{contact.address}</p>}

        {
          contact.socials && contact.socials.length > 0 && (
            <ul role="list" class="contact__socials">
              {contact.socials.map((social) => (
                <li>
                  <SocialLink social={social} />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        mapSrc && (
          <div class="contact__map">
            <iframe
              src={mapSrc}
              title={contact.title}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* "When are the courses" note. */
  .contact__courses {
    margin-top: var(--space-m);
    padding: var(--space-s) var(--space-m);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    background-color: color-mix(in srgb, var(--color-accent) 10%, var(--bg));
    font-size: var(--text-sm);
  }

  .contact__email {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .contact__tel {
    margin-top: var(--space-xs);
  }

  /* Email + phone rows: a leading icon beside the link. */
  .contact__email,
  .contact__tel {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .contact__icon {
    width: 1em;
    height: 1em;
    flex: 0 0 auto;
    fill: currentColor;
    color: var(--color-muted);
  }

  .contact__address {
    margin-top: var(--space-s);
    color: var(--color-muted);
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }

  .contact__map iframe {
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
</style>
