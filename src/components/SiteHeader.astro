---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import logo from "../assets/logo.jpg";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { currentSubpath } from "../lib/i18n-path";
import type { Locale } from "../i18n/config";
import type { SiteContent } from "../data/types";

interface Props {
  lang: Locale;
  content: SiteContent;
}

const { lang, content } = Astro.props;
const { nav, hero } = content;

// Top-level pages. `path` is the (latin) URL segment under /[lang]/; `label` is
// the localized nav text. The brand (logo + title) links to the home page.
const navItems = [
  { path: "shows", label: nav.shows },
  { path: "team", label: nav.team },
  { path: "community", label: nav.community },
  { path: "contact", label: nav.contact },
];

const homeHref = getRelativeLocaleUrl(lang);
const sub = currentSubpath(Astro.url.pathname, import.meta.env.BASE_URL);
const isActive = (path: string) => sub === path || sub.startsWith(`${path}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={homeHref}>
      <Image
        src={logo}
        alt=""
        height={40}
        densities={[1, 2]}
        class="site-header__logo"
      />
      <span class="site-header__brand-text">{hero.header_title}</span>
    </a>

    <nav class="site-nav" aria-label="Principale / Κύριο μενού">
      <ul role="list" class="site-nav__list">
        {
          navItems.map((item) => (
            <li>
              <a
                class="site-nav__link"
                href={getRelativeLocaleUrl(lang, item.path)}
                aria-current={isActive(item.path) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Pushed to the far right; the brand stays hard left. */}
    <div class="site-header__lang">
      <LanguageSwitcher lang={lang} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: var(--header-height);
    background-color: var(--chrome-bg);
    color: var(--chrome-text);
    border-bottom: 1px solid rgba(0, 0, 0, 0.18);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-s);
    min-height: var(--header-height);
    padding-block: var(--space-xs);
  }

  /* Language switcher pinned to the right edge of the bar. */
  .site-header__lang {
    margin-left: auto;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    text-decoration: none;
    color: var(--chrome-text);
    /* Keep the brand intact: never shrink, never wrap the troupe name. */
    flex-shrink: 0;
  }

  .site-header__brand-text {
    white-space: nowrap;
  }

  .site-header__logo {
    height: 2.5rem;
    width: auto;
    border-radius: var(--radius);
  }

  /* On narrow phones, keep the logo but drop the long text name. */
  @media (max-width: 26rem) {
    .site-header__brand-text {
      display: none;
    }
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    display: block;
    padding: var(--space-xs);
    text-decoration: none;
    color: var(--chrome-text);
    font-size: var(--chrome-text-size);
    white-space: nowrap;
  }

  .site-nav__link:hover {
    color: var(--color-accent);
  }

  .site-nav__link[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
