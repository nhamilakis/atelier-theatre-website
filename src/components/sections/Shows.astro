---
import { Image, getImage } from "astro:assets";
import Markdown from "../Markdown.astro";
import YouTubeEmbed from "../YouTubeEmbed.astro";
import type { SiteContent } from "../../data/types";

interface Props {
  id: string;
  shows: SiteContent["shows"];
}

const { id, shows } = Astro.props;

const leafletLabel = shows.leafletLabel ?? "Φυλλάδιο";
const galleryLabel = shows.galleryLabel ?? "Φωτογραφίες";
const creditsLabel = shows.creditsLabel ?? "Διανομή";

// Pre-render a large version of each gallery photo for the lightbox, keyed by
// show index then photo index. Empty arrays for shows without a gallery.
const galleryFullSrc = await Promise.all(
  shows.items.map((show) =>
    Promise.all(
      (show.gallery ?? []).map((photo) =>
        getImage({ src: photo.image, width: 1600 }).then((img) => img.src),
      ),
    ),
  ),
);
---

<section id={id} class="section">
  <div class="container">
    <h2 class="section__title">{shows.title}</h2>
    {shows.intro && <Markdown text={shows.intro} class="shows__intro" />}

    <ol role="list" class="shows__list">
      {
        shows.items.map((show, showIndex) => (
          <li>
            <article class="show">
              <div class="show__poster">
                {show.poster ? (
                  <Image
                    src={show.poster.image}
                    alt={show.poster.alt}
                    widths={[240, 480]}
                    sizes="(min-width: 48rem) 240px, 60vw"
                    class="show__poster-img"
                  />
                ) : (
                  <div class="show__poster-placeholder" aria-hidden="true">
                    <span>🎭</span>
                  </div>
                )}
              </div>

              <div class="show__body">
                <h3 class="show__title">{show.title}</h3>

                {show.details && show.details.length > 0 && (
                  <dl class="show__details">
                    {show.details.map((detail) => (
                      <div class="show__detail">
                        <dt>{detail.label}</dt>
                        <dd>{detail.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                <Markdown text={show.description} />

                {show.videoId && (
                  <div class="show__video">
                    <YouTubeEmbed id={show.videoId} title={show.title} caption={false} />
                  </div>
                )}

                {show.leaflet && (
                  <p class="show__fold show__leaflet">
                    <a href={show.leaflet} target="_blank" rel="noopener noreferrer">
                      {leafletLabel} →
                    </a>
                  </p>
                )}

                {show.gallery && show.gallery.length > 0 && (
                  <details class="show__fold">
                    <summary class="show__fold-summary">
                      {galleryLabel} ({show.gallery.length})
                    </summary>
                    <ul role="list" class="gallery__thumbs">
                      {show.gallery.map((photo, photoIndex) => (
                        <li>
                          <button
                            type="button"
                            class="gallery__thumb"
                            data-gallery-thumb
                            data-src={galleryFullSrc[showIndex][photoIndex]}
                            data-alt={photo.alt}
                            aria-label={`${galleryLabel}: ${photo.alt}`}
                          >
                            <Image
                              src={photo.image}
                              alt=""
                              widths={[160, 320]}
                              sizes="160px"
                              class="gallery__thumb-img"
                            />
                          </button>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}

                {show.credits && show.credits.length > 0 && (
                  <details class="show__fold">
                    <summary class="show__fold-summary">{creditsLabel}</summary>
                    <ul role="list" class="show__credits-list">
                      {show.credits.map((credit) => (
                        <li>
                          <span class="show__credit-role">{credit.role}</span>
                          <span class="show__credit-name">{credit.name}</span>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>

  {/* One shared lightbox for every gallery thumbnail in this section. */}
  <dialog class="lightbox" data-lightbox>
    <div class="lightbox__inner">
      <button
        type="button"
        class="lightbox__close"
        data-lightbox-close
        aria-label="Close"
      >
        ×
      </button>
      <img class="lightbox__img" data-lightbox-img alt="" />
    </div>
  </dialog>
</section>

<script>
  // Open the shared <dialog> lightbox when a gallery thumbnail is clicked.
  const dialog = document.querySelector("[data-lightbox]");
  const image = document.querySelector("[data-lightbox-img]");

  if (dialog instanceof HTMLDialogElement && image instanceof HTMLImageElement) {
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const thumb = target.closest("[data-gallery-thumb]");
      if (thumb instanceof HTMLElement) {
        image.src = thumb.dataset.src ?? "";
        image.alt = thumb.dataset.alt ?? "";
        dialog.showModal();
        return;
      }

      // Click on the close button, or on the backdrop (the dialog itself).
      if (target.closest("[data-lightbox-close]") || target === dialog) {
        dialog.close();
      }
    });

    // Drop the big image once closed so it isn't kept in memory.
    dialog.addEventListener("close", () => {
      image.removeAttribute("src");
    });
  }
</script>

<style>
  .shows__intro {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-s);
    color: var(--color-muted);
  }

  .shows__list {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }

  .show {
    display: grid;
    gap: var(--space-m);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .shows__list li:last-child .show {
    padding-bottom: 0;
    border-bottom: 0;
  }

  /* Side-by-side poster + text from tablet up. */
  @media (min-width: 48rem) {
    .show {
      grid-template-columns: 15rem 1fr;
      gap: var(--space-l);
      align-items: start;
    }
  }

  .show__poster-img,
  .show__poster-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .show__poster-img {
    height: auto;
    object-fit: cover;
  }

  .show__poster-placeholder {
    display: grid;
    place-items: center;
    font-size: 3rem;
    background-color: var(--color-bg);
    border: 1px dashed var(--color-border);
  }

  .show__title {
    color: var(--color-primary);
    margin-bottom: var(--space-s);
  }

  .show__details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem var(--space-s);
    margin-bottom: var(--space-m);
    font-size: var(--text-sm);
  }

  .show__detail {
    display: contents;
  }

  .show__details dt {
    color: var(--color-muted);
    font-weight: 600;
  }

  .show__details dd {
    margin: 0;
  }

  .show__video {
    margin-top: var(--space-m);
    max-width: 40rem;
  }

  /* --- Foldable / action rows (leaflet, gallery, credits) ------------------ */

  .show__fold {
    margin-top: var(--space-m);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-s);
  }

  .show__leaflet {
    font-weight: 600;
  }

  .show__leaflet a {
    text-decoration: none;
  }

  /* `.show__leaflet` is an <a>; folds use <summary>. The caret marks both. */
  .show__fold-summary,
  .show__leaflet a {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-primary);
    list-style: none;
  }

  .show__fold-summary::-webkit-details-marker {
    display: none;
  }

  .show__fold-summary::before {
    content: "▸";
    display: inline-block;
    margin-right: var(--space-xs);
    color: var(--color-accent);
    transition: transform 0.15s ease;
  }

  .show__fold[open] .show__fold-summary::before {
    transform: rotate(90deg);
  }

  /* --- Credits list -------------------------------------------------------- */

  .show__credits-list {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
    font-size: var(--text-sm);
  }

  .show__credit-role {
    color: var(--color-muted);
  }

  .show__credit-role::after {
    content: " — ";
  }

  /* --- Gallery thumbnails -------------------------------------------------- */

  .gallery__thumbs {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
    gap: var(--space-xs);
  }

  .gallery__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .gallery__thumb-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    object-fit: cover;
    transition: transform 0.15s ease;
  }

  .gallery__thumb:hover .gallery__thumb-img,
  .gallery__thumb:focus-visible .gallery__thumb-img {
    transform: scale(1.05);
  }

  /* --- Lightbox dialog ----------------------------------------------------- */

  /* Fill the viewport and center the image with flexbox, so centering never
     depends on the image's size being known at open time (the UA's default
     margin-auto centering breaks when the src is set just before showModal). */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: rgba(26, 22, 20, 0.85);
  }

  .lightbox__inner {
    position: relative;
    display: inline-block;
    line-height: 0;
  }

  .lightbox__img {
    display: block;
    max-width: 92vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .lightbox__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-ink);
    background: var(--color-bg);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: var(--shadow);
  }
</style>
