---
// Reusable prose section: a heading followed by a Markdown body.
// Used for the sections that are purely text (company).
import Markdown from "../Markdown.astro";
import type { SectionText } from "../../data/types";

interface Props {
  id: string;
  section: SectionText;
}

const { id, section } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <h2 class="section__title">{section.title}</h2>
    <Markdown text={section.body} class="prose" />
  </div>
</section>
