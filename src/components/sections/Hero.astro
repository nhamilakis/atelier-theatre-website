---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { SiteContent } from "../../data/types";

interface Props {
  hero: SiteContent["hero"];
  // Optional photo shown (scrimmed) behind the group name.
  banner?: ImageMetadata;
}

const { hero, banner } = Astro.props;
---

<section class:list={["hero", { "hero--has-bg": banner }]}>
  {
    banner && (
      <div class="hero__bg" aria-hidden="true">
        <Image
          src={banner}
          alt=""
          widths={[768, 1280, 1920]}
          sizes="100vw"
          class="hero__bg-img"
        />
      </div>
    )
  }

  <div class="container hero__inner">
    <h1 class="hero__title">{hero.title}</h1>
    <span class="hero__rule" aria-hidden="true"></span>
    <p class="hero__tagline">{hero.tagline}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-xl) var(--space-2xl);
    /* Fallback tint shown when there's no banner image. */
    background:
      radial-gradient(
        120% 100% at 50% 0%,
        color-mix(in srgb, var(--title-color) 10%, var(--bg)) 0%,
        var(--bg) 70%
      );
  }

  /* A banner gives the hero more height to show the photo. */
  .hero--has-bg {
    padding-block: var(--space-2xl);
  }

  /* Photo background layer, behind the content. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Light scrim so the title stays legible over the photo. */
  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 62%, transparent);
  }

  .hero__inner {
    /* Above the background layer. */
    position: relative;
    z-index: 1;
    /* Wide enough not to cap the title. The title/tagline set their own, tighter
       max-widths below, so this just removes the parent as the bottleneck. */
    max-width: var(--container-width);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__title {
    color: var(--title-color);
    /* Smaller than the global h1 so a long title stays readable, not huge. */
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3rem);
    /* THE WIDTH KNOB: raise this to let the title run wider (fewer line breaks),
       lower it for a narrower, taller block. The parent (.hero__inner) is now
       wide enough that this value is what actually controls the width. */
    max-width: 30ch;
    text-wrap: balance;
  }

  .hero__rule {
    display: block;
    width: 3rem;
    height: 3px;
    margin-block: var(--space-m);
    background-color: var(--color-accent);
  }

  .hero__tagline {
    max-width: 42ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
    font-style: italic;
    text-wrap: balance;
  }
</style>
