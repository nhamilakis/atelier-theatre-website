---
import Markdown from "../Markdown.astro";
import type { SiteContent } from "../../data/types";

interface Props {
  id: string;
  community: SiteContent["community"];
}

const { id, community } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <h2 class="section__title">{community.title}</h2>
    <div class="prose">
      <Markdown text={community.body} />

      {
        community.link && (
          <p class="community__link">
            <a href={community.link.href} rel="noopener noreferrer" target="_blank">
              {community.link.label} →
            </a>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .community__link {
    margin-top: var(--space-m);
    font-weight: 600;
  }
</style>
