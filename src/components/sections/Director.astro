---
import type { SiteContent } from "../../data/types";

interface Props {
  id: string;
  director: SiteContent["director"];
}

const { id, director } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <h2 class="section__title">{director.title}</h2>
    <div class="prose">
      <p class="director__name">{director.name}</p>
      {director.body.map((paragraph) => <p class="director__p">{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .director__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: var(--space-s);
  }

  .director__p + .director__p {
    margin-top: var(--space-s);
  }
</style>
