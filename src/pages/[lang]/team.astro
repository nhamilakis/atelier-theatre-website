---
// OUR TEAM (Η ομάδα): whole-team photo + director/teacher + current members
// (with year). Content comes from the `team` object in the data files.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Team from "../../components/Team.astro";
import { content } from "../../data";
import { LOCALES } from "../../i18n/config";
import type { Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const data = content[lang];
const pageTitle = `${data.team.title} — ${data.meta.title}`;
---

<BaseLayout lang={lang} content={data} title={pageTitle}>
  <Team team={data.team} lang={lang} />
</BaseLayout>
