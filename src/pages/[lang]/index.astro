---
// HOME: hero banner → Who we are → News → Latest show → Articles & mentions →
// Contact (+ Crowdfunding when present). Assembled in the Home component.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Home from "../../components/Home.astro";
import { getCollection } from "astro:content";
import { content } from "../../data";
import { LOCALES } from "../../i18n/config";
import type { Locale } from "../../i18n/config";

// One static page per locale: /fr/ and /el/.
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const data = content[lang];

// News posts for this language, newest first.
const news = (
  await getCollection("news", ({ data }) => data.lang === lang)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout lang={lang} content={data}>
  <Home content={data} lang={lang} news={news} />
</BaseLayout>
