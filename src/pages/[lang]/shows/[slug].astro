---
// One page per production: /[lang]/shows/<slug>. The slug comes from each
// Show in the data; a show only exists in a locale if that locale's data lists
// it (e.g. "paramythi" has no /fr/ page yet).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShowDetail from "../../../components/ShowDetail.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { content } from "../../../data";
import { LOCALES } from "../../../i18n/config";
import type { Locale } from "../../../i18n/config";
import type { Show } from "../../../data/types";

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    content[lang].shows.items.map((show) => ({
      params: { lang, slug: show.slug },
      props: { show },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const { show } = Astro.props as { show: Show };
const data = content[lang];
const { shows } = data;
const pageTitle = `${show.title} — ${data.meta.title}`;
---

<BaseLayout lang={lang} content={data} title={pageTitle}>
  <section class="section">
    <div class="container">
      <ShowDetail
        show={show}
        lang={lang}
        leafletLabel={shows.leafletLabel || "Φυλλάδιο"}
        galleryLabel={shows.galleryLabel ?? "Φωτογραφίες"}
        creditsLabel={shows.creditsLabel ?? "Διανομή"}
        backHref={getRelativeLocaleUrl(lang, "shows")}
        backLabel={data.nav.shows}
      />
    </div>
  </section>
</BaseLayout>
